<?xml version="1.0" encoding="utf-8" ?>
<manifest>
  <!--
    The version here is what the Power Platform upgrades on, and the release
    workflow refuses to publish a tag that disagrees with it. Bump this in the
    same commit as the tag.
  -->
  <control namespace="PCFHub"
           constructor="KanbanBoard"
           version="0.1.0"
           display-name-key="KanbanBoard_Name"
           description-key="KanbanBoard_Desc"
           control-type="virtual">

    <external-service-usage enabled="false" />

    <!--
      Roles, deliberately — the opposite decision from pcf-data-table and
      pcf-compact-list, and for the reason the template gives: this control
      assigns meaning to specific columns, the way a chip has a label and a
      colour. A card has a lane, a headline, and optionally a person and a
      badge. It does not render "whatever the view supplies", so there is
      nothing for it to read off dataset.columns generically.

      The arity is fixed here permanently. Roles can be added in a later
      version; they cannot be removed without breaking every maker who bound
      one. Four is the considered ceiling: statusField and titleField are what
      a board *is*, and the other two are the difference between a usable card
      and a coloured rectangle.

      Found on the column by `alias`, read off the record by `name`. Getting
      that backwards renders nothing at all against a real view while passing a
      fixture whose alias and name are the same string — which is why
      demo/records.json here uses realistic, different values.
    -->
    <data-set name="records" display-name-key="Records_DataSet_Name">
      <!--
        The lane the card sits in, and the only column this control writes.

        of-type="OptionSet" rather than a text column: the lanes are the
        option set's values, and moving a card writes the option's *number*.
        Binding this to text would make the write meaningless.
      -->
      <property-set name="statusField"
                    display-name-key="StatusField_Name"
                    of-type="OptionSet"
                    usage="bound"
                    required="true" />

      <property-set name="titleField"
                    display-name-key="TitleField_Name"
                    of-type="SingleLine.Text"
                    usage="bound"
                    required="true" />

      <property-set name="assigneeField"
                    display-name-key="AssigneeField_Name"
                    of-type="SingleLine.Text"
                    usage="bound"
                    required="false" />

      <property-set name="badgeField"
                    display-name-key="BadgeField_Name"
                    of-type="SingleLine.Text"
                    usage="bound"
                    required="false" />
    </data-set>

    <!--
      No `cds-data-set-options`, following the template's own rule: a control
      with fixed roles wants the subgrid chrome off, because its layout does not
      survive the maker picking a different view. The command bar would also
      have nothing to act on — this control never calls setSelectedRecordIds().
    -->

    <!--
      The lanes, when deriving them is not enough.

      Left empty, the lanes are the distinct values actually present in the
      bound records — which is right most of the time and cannot invent a lane
      that no record is in. An empty "Done" column is exactly what a board
      needs to show, so this is the escape hatch: "1=New,2=Active,3=Resolved"
      fixes both the set and the order.

      A plain text input rather than a metadata lookup. Reading the option set
      through context.utils.getEntityMetadata would give every lane in the
      maker's own order, and costs a second install-time permission prompt plus
      a code path that does not exist in canvas or in the hub's demo harness.
      The trade is deliberate; see SPEC.md.
    -->
    <property name="lanes"
              display-name-key="Lanes_Name"
              description-key="Lanes_Desc"
              of-type="SingleLine.Text"
              usage="input"
              required="false" />

    <property name="laneWidth"
              display-name-key="LaneWidth_Name"
              description-key="LaneWidth_Desc"
              of-type="Whole.None"
              usage="input"
              required="false"
              default-value="280" />

    <property name="openOnCardClick"
              display-name-key="OpenOnCardClick_Name"
              description-key="OpenOnCardClick_Desc"
              of-type="TwoOptions"
              usage="input"
              required="false"
              default-value="true" />

    <!--
      A board loads more, it does not turn pages, so this is how many cards
      arrive per fetch rather than how many are on screen. The platform clamps
      large values.
    -->
    <property name="pageSize"
              display-name-key="PageSize_Name"
              description-key="PageSize_Desc"
              of-type="Whole.None"
              usage="input"
              required="false"
              default-value="50" />

    <!--
      Two outputs, because "which card moved" and "which card was opened" are
      different questions a form reacts to differently.

      Both are notified *before* the platform call they describe, so the value
      is observable even on a host where the call does nothing — the canvas
      case for openDatasetItem, and the failure case for updateRecord.
    -->
    <property name="movedRecordId"
              display-name-key="MovedRecordId_Name"
              description-key="MovedRecordId_Desc"
              of-type="SingleLine.Text"
              usage="output" />

    <property name="openedRecordId"
              display-name-key="OpenedRecordId_Name"
              description-key="OpenedRecordId_Desc"
              of-type="SingleLine.Text"
              usage="output" />

    <resources>
      <code path="index.ts" order="1" />
      <css path="css/KanbanBoard.css" order="1" />
      <platform-library name="React" version="16.14.0" />
      <platform-library name="Fluent" version="9.46.2" />
      <resx path="strings/KanbanBoard.1033.resx" version="1.0.0" />
    </resources>

    <!--
      WebAPI only, and it is genuinely used: moving a card calls
      updateRecord(). That is one install-time permission prompt this control
      has earned, and the reason the lanes are derived rather than read through
      Utility — a second prompt for something a text property can answer is not
      a trade worth making.

      openDatasetItem() needs no feature: it is a method on the dataset itself,
      not on context.navigation.
    -->
    <feature-usage>
      <uses-feature name="WebAPI" required="true" />
    </feature-usage>
  </control>
</manifest>
